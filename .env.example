# ---- Which chains to run ----
ENABLE_SOLANA=true
ENABLE_BSC=false

# SAFE DEFAULT: true. Nothing real ever trades while this is true.
# Only set to "false" (exact string) once you've watched DRY_RUN behavior
# for a while and are ready to risk real funds.
DRY_RUN=true

# How selective the scanner is — max tokens it will recommend/trade per
# UTC day, across both chains combined.
MAX_TOKENS_PER_DAY=5

# ---- Solana / pump.fun ----
# Get this from https://helius.dev — free tier is enough to start testing.
# Required only if ENABLE_SOLANA=true.
HELIUS_API_KEY=

# Base58-encoded private key for a DEDICATED bot wallet.
# NEVER your main wallet. Only required once DRY_RUN=false.
WALLET_PRIVATE_KEY=

CAPITAL_PCT=5
MAX_POSITION_SOL=0.5
MAX_CONCURRENT_POSITIONS=1
SLIPPAGE_BPS=500
PRIORITY_FEE_LAMPORTS=100000

# ---- BNB Smart Chain / PancakeSwap ----
# Free public RPC by default. Get a dedicated key (Ankr/QuickNode/NodeReal/
# Chainstack) before trading real funds — public endpoints can be slow or
# rate-limited exactly when you need them fastest.
BSC_RPC_URL=https://bsc-rpc.publicnode.com
BSC_WSS_URL=wss://bsc-rpc.publicnode.com

# Hex-encoded (0x...) private key for a DEDICATED BSC bot wallet.
# NEVER your main wallet. Only required once DRY_RUN=false and ENABLE_BSC=true.
BSC_WALLET_PRIVATE_KEY=

BSC_CAPITAL_PCT=5
BSC_MAX_POSITION_BNB=0.1
BSC_MAX_CONCURRENT_POSITIONS=1
BSC_SLIPPAGE_BPS=700

# ---- Shared strategy fallbacks (rarely need to touch these — the risk
# engine sets a per-token TP/SL/max-hold based on that token's risk tier) ----
TAKE_PROFIT_PCT=25
STOP_LOSS_PCT=-50
MAX_POSITION_AGE_MS=1800000
PRICE_POLL_INTERVAL_MS=4000

# ---- Live control layer (recommended for 24/7 operation) ----
# Without these two, the bot still runs fine — you just lose live filter
# updates, the Telegram bot's ability to change them, and the dashboard
# feed. Get these from Supabase project settings > API. Use the
# service_role key here (server-side only — never put it in the
# dashboard/browser code, use the anon key there instead).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Create a bot with @BotFather on Telegram to get this token.
TELEGRAM_BOT_TOKEN=
# Leave blank at first — send /start to your bot, it will reply with your
# chat ID, then put that here so only you can control it.
TELEGRAM_CHAT_ID=

# ---- Optional overrides — only change these if you know why. ----
# PUMPFUN_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
# JUPITER_QUOTE_URL=https://quote-api.jup.ag/v6/quote
# JUPITER_SWAP_URL=https://quote-api.jup.ag/v6/swap
# PANCAKESWAP_FACTORY=0xcA143Ce32Fe78f1f7019d7d551a6402fC5350c73
# PANCAKESWAP_ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256024E
# WBNB_ADDRESS=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
