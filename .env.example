# =============================================================================
# Sniper Trader — environment variables
# Copy to .env (local) or set the same keys on Railway / your host.
# Never commit real keys. DRY_RUN=true until you are ready for real funds.
# =============================================================================

# ---- Chains ----
ENABLE_SOLANA=true
ENABLE_BSC=false
# Watch pre-migration pump curve tokens and buy via PumpPortal when enabled
ENABLE_GRADUATION_WATCH=true

# SAFE DEFAULT. Only the exact string "false" enables real trades.
DRY_RUN=true

# Daily recommend/trade quota (Telegram can raise this live)
MAX_TOKENS_PER_DAY=50

# ---- Solana ----
# https://helius.dev — required when ENABLE_SOLANA=true
HELIUS_API_KEY=
# Optional when Helius quota is exhausted (429 max usage):
# SOLANA_RPC_URL=
# SOLANA_WSS_URL=
SOLANA_RPC_FALLBACK=https://solana-rpc.publicnode.com
SOLANA_WSS_FALLBACK=wss://solana-rpc.publicnode.com


# Base58 private key for a DEDICATED bot wallet (never your main wallet).
# Required only when DRY_RUN=false.
WALLET_PRIVATE_KEY=

CAPITAL_PCT=10
MAX_POSITION_SOL=0.5
SOL_FEE_RESERVE=0.01
MAX_CONCURRENT_POSITIONS=1
# Buy slippage in basis points (2500 = 25%). Pump curves need room.
SLIPPAGE_BPS=2500
# Exit sell slippage % for PumpPortal (thin curve liquidity)
EXIT_SLIPPAGE_PCT=25
PRIORITY_FEE_LAMPORTS=100000

# Optional program ID overrides
PUMPFUN_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
BOOP_PROGRAM_ID=boop8hVGQGqezHQMUMzRQRJ99nCmSP4zjaGE75tfj957
PUMPPORTAL_TRADE_URL=https://pumpportal.fun/api/trade-local

JUPITER_QUOTE_URL=https://quote-api.jup.ag/v6/quote
JUPITER_SWAP_URL=https://quote-api.jup.ag/v6/swap

# Strategy fallbacks when Telegram exit is set to "auto" (0)
TAKE_PROFIT_PCT=25
STOP_LOSS_PCT=-50
MAX_POSITION_AGE_MS=1800000
PRICE_POLL_INTERVAL_MS=4000
DETECTOR_STALL_MS=180000
# RPC poll fallback when WSS is quiet (ms). Higher = fewer Helius calls.
DETECTOR_POLL_MS=60000
HEARTBEAT_MIN=60

# ---- BNB Smart Chain (only if ENABLE_BSC=true) ----
BSC_RPC_URL=https://bsc-rpc.publicnode.com
BSC_WSS_URL=wss://bsc-rpc.publicnode.com
BSC_WALLET_PRIVATE_KEY=
BSC_CAPITAL_PCT=10
BSC_MAX_POSITION_BNB=0.1
BNB_FEE_RESERVE=0.003
BSC_MAX_CONCURRENT_POSITIONS=1
BSC_SLIPPAGE_BPS=700

# ---- Live control (Telegram + optional dashboard) ----
# Supabase → Project Settings → API
# Bot uses SERVICE key (server only). Dashboard uses ANON key in browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# @BotFather token
TELEGRAM_BOT_TOKEN=
# Your numeric chat id (bot replies with it on /start). Restricts control to you.
TELEGRAM_CHAT_ID=

# Optional: HTTPS URL of the dashboard Mini App (Telegram menu button)
DASHBOARD_WEBAPP_URL=
DASHBOARD_URL=

# ---- Dashboard only (dashboard/.env) ----
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# DASHBOARD_PASSWORD=

# Exit sells (dangerous if too low on thin pumps)
EXIT_SLIPPAGE_PCT=40
SELL_ATTEMPTS=8
SELL_SLIP_LADDER=40,50,60,70,80,90,95
